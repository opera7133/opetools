---
import { twMerge } from "tailwind-merge";
const { class: className, ...rest } = Astro.props;
---

<footer
  class={twMerge(
    "border-t border-gray-200 py-8 px-8 text-center text-gray-600 text-sm",
    className,
  )}
>
  <p>
    See source code on
    <a
      href="https://github.com/opera7133/opetools"
      class="text-gray-600 hover:text-gray-800 underline"
    >
      opera7133/opetools
    </a>
  </p>
  <p>
    Licensed under
    <a
      href="https://opensource.org/licenses/MIT"
      class="text-gray-600 hover:text-gray-800 underline">MIT License</a
    >
  </p>
</footer>
