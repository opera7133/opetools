---
import { meitetsuNagoya } from "../../data/train-master/meitetsu/nagoya";
import { tokaidoNagoya } from "../../data/train-master/jr-central/tokaido-nagoya";
import { tokaidoShizuoka } from "../../data/train-master/jr-central/tokaido-shizuoka";
import { tokaidoAkasaka } from "../../data/train-master/jr-central/tokaido-akasaka";
import { jrCentralChuo } from "../../data/train-master/jr-central/chuo";
import { iida } from "../../data/train-master/jr-central/iida";
import { tokaidoShinkansen } from "../../data/train-master/jr-central/shinkansen";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";

export async function getStaticPaths() {
  const lines = [
    meitetsuNagoya,
    tokaidoNagoya,
    tokaidoShizuoka,
    tokaidoAkasaka,
    jrCentralChuo,
    iida,
    tokaidoShinkansen
  ];
  return lines.map((line) => ({
    params: { line: line.id },
    props: { line, allLines: lines },
  }));
}

const { line: activeLine, allLines } = Astro.props;

// Helper to normalize StopPattern into StopConfig
function getStopConfig(stopPattern: any) {
  if (!stopPattern) return { type: "pass" as const };
  if (typeof stopPattern === "string") {
    return { type: stopPattern as any };
  }
  return stopPattern;
}

// Calculate the active service range (start & end index) for each train type
const typeServiceRanges = activeLine.types.map((type) => {
  let startIndex = -1;
  let endIndex = -1;

  for (let i = 0; i < activeLine.stations.length; i++) {
    const station = activeLine.stations[i];
    if (type.stops[station.id] !== undefined) {
      if (startIndex === -1) {
        startIndex = i;
      }
      endIndex = i;
    }
  }

  return {
    typeId: type.id,
    startIndex,
    endIndex,
  };
});
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{activeLine.name} 停車駅案内 || train || opetools</title>
    <meta name="description" content={`${activeLine.name}の列車種別ごとの停車駅案内図です。`} />
    <link rel="icon" type="image/png" href="../favicon.png" />
  </head>
  <body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col font-sans">
    <Header class="bg-gray-100" />

    <main class="flex-1 max-w-6xl w-full mx-auto px-4 py-8 md:py-12">
      <!-- Breadcrumb navigation -->
      <div class="mb-6">
        <a
          href="/train"
          class="text-xs font-semibold text-slate-400 hover:text-white flex items-center gap-1.5 transition-colors"
        >
          <span>⬅</span> 路線一覧へ戻る
        </a>
      </div>

      <div class="mb-8">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xs font-bold px-2 py-0.5 bg-blue-900/60 text-blue-300 rounded border border-blue-800/40">
            {activeLine.company}
          </span>
          <span class="text-slate-500">/</span>
          <span class="text-xs font-medium text-slate-400">路線詳細</span>
        </div>
        <h1 class="text-3xl font-extrabold text-white tracking-tight">
          {activeLine.name} 停車駅案内
        </h1>
      </div>

      <!-- Legend -->
      <div class="bg-slate-800/40 rounded-xl p-4 border border-slate-700/40 mb-8">
        <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">記号の凡例</h3>
        <div class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
          <div class="flex items-center gap-2">
            <svg viewBox="0 0 24 24" class="w-5 h-5 drop-shadow-sm">
              <rect x="2" y="2" width="20" height="20" rx="4" class="fill-emerald-500" />
              <rect x="6" y="6" width="12" height="12" rx="2" class="fill-white" />
            </svg>
            <span>始発・終着駅</span>
          </div>
          <div class="flex items-center gap-2">
            <svg viewBox="0 0 24 24" class="w-5 h-5 drop-shadow-sm">
              <circle cx="12" cy="12" r="10" class="fill-blue-500" />
              <circle cx="12" cy="12" r="5" class="fill-white" />
            </svg>
            <span>停車駅</span>
          </div>
          <div class="flex items-center gap-2">
            <svg viewBox="0 0 24 24" class="w-5 h-5 drop-shadow-sm">
              <circle cx="12" cy="12" r="10" class="fill-amber-500" />
              <circle cx="12" cy="12" r="7" class="fill-white" />
              <circle cx="12" cy="12" r="3" class="fill-amber-500" />
            </svg>
            <span>一部停車（多）</span>
          </div>
          <div class="flex items-center gap-2">
            <svg viewBox="0 0 24 24" class="w-5 h-5 drop-shadow-sm">
              <polygon points="12,2 22,20 2,20" class="fill-orange-500" />
              <polygon points="12,8 18,18 6,18" class="fill-white" />
            </svg>
            <span>一部停車（中）</span>
          </div>
          <div class="flex items-center gap-2">
            <svg viewBox="0 0 24 24" class="w-5 h-5 drop-shadow-sm">
              <polygon points="12,2 22,20 2,20" class="fill-white stroke-red-500 stroke-[3px]" />
            </svg>
            <span>一部停車（少）</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-1.5 h-6 bg-slate-500 rounded-full"></div>
            <span>通過</span>
          </div>
        </div>
      </div>

      <!-- Main Station Grid Table -->
      <div class="bg-slate-800/30 rounded-2xl border border-slate-700/50 shadow-xl overflow-x-auto">
        <div class="min-w-200 p-6">

          <!-- Grid Header (Train Type Columns) -->
          <div class="flex items-end border-b border-slate-700 pb-4 mb-4">
            <!-- Left Header: Station Info spacer -->
            <div class="w-72 pr-4 shrink-0">
              <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">駅名 / ナンバリング</span>
            </div>

            <!-- Center Header: Train Types -->
            <div class="flex items-stretch shrink-0">
              {activeLine.types.map((type) => (
                <div class="w-16 text-center flex flex-col items-center justify-end h-32 px-1 shrink-0">
                  <!-- Type Name badge rotated or vertical -->
                  <div
                    class="px-2 py-1 rounded text-xs font-bold text-white shadow-sm select-none mb-2 w-12 text-center wrap-break-word leading-tight"
                    style={`background-color: ${type.color}; text-shadow: 0 1px 2px rgba(0,0,0,0.3);`}
                  >
                    {type.name}
                  </div>
                </div>
              ))}
            </div>

            <!-- Right Header: Through services spacer -->
            <div class="flex-1 pl-8">
              <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">直通・接続路線</span>
            </div>
          </div>

          <!-- Station Rows -->
          <div class="flex flex-col">
            {activeLine.stations.map((station, stationIndex) => {
              return (
                <div class="flex items-center group/row hover:bg-slate-800/40 rounded-lg transition-colors duration-150">
                  <!-- 1. Station Info (width: 72 -> 288px) -->
                  <div class="w-72 flex items-center gap-3 px-2 shrink-0">
                    {station.code ? (
                      <span class="text-xs font-mono font-bold px-2 py-1 bg-slate-700 text-slate-200 rounded border border-slate-600/50 min-w-12.5 text-center">
                        {station.code}
                      </span>
                    ) : (
                      <span class="w-12.5"></span>
                    )}
                    <div>
                      <div class="text-base font-bold text-slate-100 group-hover/row:text-white transition-colors">
                        {station.name}
                      </div>
                      <div class="text-[11px] text-slate-400 font-medium group-hover/row:text-slate-300">
                        {station.kana} / {station.romaji}
                      </div>
                    </div>
                  </div>

                  <!-- 2. Train Types (Columns) -->
                  <div class="flex items-stretch h-14 shrink-0">
                    {activeLine.types.map((type, typeIndex) => {
                      const stopPattern = type.stops[station.id];
                      const config = getStopConfig(stopPattern);

                      const range = typeServiceRanges.find(r => r.typeId === type.id) || { startIndex: 0, endIndex: activeLine.stations.length - 1 };
                      const isInsideService = stationIndex >= range.startIndex && stationIndex <= range.endIndex;

                      const isFirst = stationIndex === range.startIndex;
                      const isLast = stationIndex === range.endIndex;

                      return (
                        <div
                          class="w-16 relative flex items-center justify-center group/cell shrink-0"
                          style={`--type-color: ${type.color}`}
                        >
                          {isInsideService && (
                            <>
                              <!-- Vertical connection line -->
                              <div
                                class="absolute w-1.5"
                                style={{
                                  backgroundColor: type.color,
                                  top: isFirst ? '50%' : '0',
                                  bottom: isLast ? '50%' : '0',
                                  left: '50%',
                                  transform: 'translateX(-50%)',
                                  zIndex: 1
                                }}
                              />

                              <!-- Horizontal branch line for throughTo -->
                              {config.throughTo && (
                                <div
                                  class="absolute h-1"
                                  style={{
                                    backgroundColor: type.color,
                                    left: '50%',
                                    // Calculate width dynamically to reach the through service area
                                    width: `calc(64px * (${activeLine.types.length - 1 - typeIndex}) + 32px + 28px)`,
                                    zIndex: 2,
                                    top: '50%',
                                    transform: 'translateY(-50%)',
                                    opacity: 0.8
                                  }}
                                />
                              )}

                              <!-- Marker SVG depending on StopType -->
                              <div class="relative z-10">
                                {config.type === 'terminal' && (
                                  <svg viewBox="0 0 24 24" class="w-6 h-6 drop-shadow-sm cursor-help">
                                    <rect x="2" y="2" width="20" height="20" rx="4" class="fill-(--type-color)" />
                                    <rect x="6" y="6" width="12" height="12" rx="2" class="fill-white" />
                                  </svg>
                                )}
                                {config.type === 'stop' && (
                                  <svg viewBox="0 0 24 24" class="w-5 h-5 drop-shadow-sm cursor-help">
                                    <circle cx="12" cy="12" r="10" class="fill-(--type-color)" />
                                    <circle cx="12" cy="12" r="5" class="fill-white" />
                                  </svg>
                                )}
                                {config.type === 'mostly' && (
                                  <svg viewBox="0 0 24 24" class="w-5 h-5 drop-shadow-sm cursor-help">
                                    <circle cx="12" cy="12" r="10" class="fill-(--type-color)" />
                                    <circle cx="12" cy="12" r="7" class="fill-white" />
                                    <circle cx="12" cy="12" r="3" class="fill-(--type-color)" />
                                  </svg>
                                )}
                                {config.type === 'partial' && (
                                  <svg viewBox="0 0 24 24" class="w-5 h-5 drop-shadow-sm cursor-help">
                                    <polygon points="12,2 22,20 2,20" class="fill-(--type-color)" />
                                    <polygon points="12,8 18,18 6,18" class="fill-white" />
                                  </svg>
                                )}
                                {config.type === 'rare' && (
                                  <svg viewBox="0 0 24 24" class="w-5 h-5 drop-shadow-sm cursor-help">
                                    <polygon points="12,2 22,20 2,20" class="fill-white stroke-(--type-color) stroke-[3px]" />
                                  </svg>
                                )}
                                {config.type === 'pass' && (
                                  <div class="w-2.5 h-2.5 rounded-full bg-slate-650 border border-slate-500 opacity-60 group-hover/row:opacity-100 transition-opacity" />
                                )}
                              </div>

                              <!-- Tooltip for Stop Remark -->
                              {config.remark && (
                                <div class="absolute bottom-full mb-2 hidden group-hover/cell:block bg-slate-950 text-slate-100 text-xs py-1.5 px-2.5 rounded border border-slate-750 shadow-lg z-30 whitespace-nowrap">
                                  {config.remark}
                                </div>
                              )}
                            </>
                          )}
                        </div>
                      );
                    })}
                  </div>

                  <!-- 3. Through Services & Connection info (Right column) -->
                  <div class="flex-1 pl-8 flex flex-col justify-center gap-1.5 py-1 min-w-62.5">
                    {activeLine.types.map((type) => {
                      const stopPattern = type.stops[station.id];
                      const config = getStopConfig(stopPattern);
                      if (!config.throughTo) return null;

                      // Resolve route path correctly. If the through line has data, it can link to `/train/${id}`.
                      const isThroughLineRegistered = allLines.some(l => l.id === config.throughTo?.lineId);
                      const href = isThroughLineRegistered ? `/train/${config.throughTo.lineId}` : `/train`;

                      return (
                        <div class="flex items-center gap-2 text-xs">
                          <span
                            class="px-2 py-0.5 rounded text-white font-bold text-[10px] shadow-sm select-none"
                            style={`background-color: ${type.color}`}
                          >
                            {type.name}
                          </span>
                          <span class="text-slate-500 font-bold">➡</span>
                          <a
                            href={href}
                            class="text-blue-400 hover:text-blue-300 hover:underline font-bold flex items-center gap-0.5 transition-colors"
                          >
                            {config.throughTo.lineName}
                            <span class="text-[10px] text-slate-400">↗</span>
                          </a>
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            })}
          </div>

        </div>
      </div>
    </main>

    <Footer class="bg-gray-100" />
  </body>
</html>
