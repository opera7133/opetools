---
import Layout from "../layouts/Layout.astro";
---

<Layout title="opera7133/opetools" description="Various tools for me to use">
  <main class="max-w-4xl mx-auto py-12 px-8">
    <div class="flex flex-col gap-6">
      <a
        href="/envelope"
        class="border border-gray-300 p-4 no-underline text-gray-800 transition-colors hover:border-gray-800 hover:bg-gray-200 flex flex-row items-center"
      >
        <p class="mr-4 text-4xl text-gray-600">&gt;</p>
        <div>
          <h2 class="text-xl font-semibold mb-2">envelope</h2>
          <p class="text-sm text-gray-600">角2封筒の宛名を作成するツール</p>
        </div>
      </a>

      <a
        href="/pukiwiki"
        class="border border-gray-300 p-4 no-underline text-gray-800 transition-colors hover:border-gray-800 hover:bg-gray-200 flex flex-row items-center"
      >
        <p class="mr-4 text-4xl text-gray-600">&gt;</p>
        <div>
          <h2 class="text-xl font-semibold mb-2">pukiwiki</h2>
          <p class="text-sm text-gray-600">主にpukiwiki関連のツール</p>
        </div>
      </a>

      <a
        href="/foods"
        class="border border-gray-300 p-4 no-underline text-gray-800 transition-colors hover:border-gray-800 hover:bg-gray-200 flex flex-row items-center"
      >
        <p class="mr-4 text-4xl text-gray-600">&gt;</p>
        <div>
          <h2 class="text-xl font-semibold mb-2">foods</h2>
          <p class="text-sm text-gray-600">毎日の食費を記録・管理するツール</p>
        </div>
      </a>

      <a
        href="/retail"
        class="border border-gray-300 p-4 no-underline text-gray-800 transition-colors hover:border-gray-800 hover:bg-gray-200 flex flex-row items-center"
      >
        <p class="mr-4 text-4xl text-gray-600">&gt;</p>
        <div>
          <h2 class="text-xl font-semibold mb-2">retail</h2>
          <p class="text-sm text-gray-600">店ごとの食材の値段比較をする</p>
        </div>
      </a>

      <a
        href="/timer"
        class="border border-gray-300 p-4 no-underline text-gray-800 transition-colors hover:border-gray-800 hover:bg-gray-200 flex flex-row items-center"
      >
        <p class="mr-4 text-4xl text-gray-600">&gt;</p>
        <div>
          <h2 class="text-xl font-semibold mb-2">timer</h2>
          <p class="text-sm text-gray-600">プレゼンタイマー</p>
        </div>
      </a>

      <a
        href="/attendance"
        class="border border-gray-300 p-4 no-underline text-gray-800 transition-colors hover:border-gray-800 hover:bg-gray-200 flex flex-row items-center"
      >
        <p class="mr-4 text-4xl text-gray-600">&gt;</p>
        <div>
          <h2 class="text-xl font-semibold mb-2">attendance</h2>
          <p class="text-sm text-gray-600">授業の出席コードを記録・管理するツール</p>
        </div>
      </a>

      <a
        href="/train"
        class="border border-gray-300 p-4 no-underline text-gray-800 transition-colors hover:border-gray-800 hover:bg-gray-200 flex flex-row items-center"
      >
        <p class="mr-4 text-4xl text-gray-600">&gt;</p>
        <div>
          <h2 class="text-xl font-semibold mb-2">train</h2>
          <p class="text-sm text-gray-600">
            鉄道路線の種別ごとの停車駅を表示するツール
          </p>
        </div>
      </a>

      <a
        href="https://station-picker.pages.dev"
        class="border border-gray-300 p-4 no-underline text-gray-800 transition-colors hover:border-gray-800 hover:bg-gray-200 flex flex-row items-center"
      >
        <p class="mr-4 text-4xl text-gray-600">↗</p>
        <div>
          <h2 class="text-xl font-semibold mb-2">Station Picker</h2>
          <p class="text-sm text-gray-600">全国の駅からランダムに抽選</p>
        </div>
      </a>

      <a
        href="https://nationwide-ic.pages.dev"
        class="border border-gray-300 p-4 no-underline text-gray-800 transition-colors hover:border-gray-800 hover:bg-gray-200 flex flex-row items-center"
      >
        <p class="mr-4 text-4xl text-gray-600">↗</p>
        <div>
          <h2 class="text-xl font-semibold mb-2">
            全国(共通)交通系ICカード一覧
          </h2>
          <p class="text-sm text-gray-600">全国の交通系ICカード一覧・管理</p>
        </div>
      </a>
    </div>
  </main>
</Layout>
